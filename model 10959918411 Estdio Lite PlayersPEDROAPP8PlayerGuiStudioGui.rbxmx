						v_u_18.Text = "--Rain a thing from ServerStorage.\nlocal Debris = game:GetService(\"Debris\")  --Roblox utility to destroy stuff.\nwhile true do\n  wait(.2)     --.2 is one fifth of a second.  So five bricks per second.\n  local newRainDrop = game.ServerStorage.mesh:Clone()\n  newRainDrop.Position = Vector3.new(math.random(-30,30), 30, math.random(-30,30))\n  newRainDrop.Parent = game.Workspace\n  Debris:AddItem(newRainDrop, 10)  --Delete each brick 10 seconds after it\'s created.\nend\n"
