						v_u_18:WaitForChild("SaveChangesTo").Value.Text = v_u_18.ContentText
						v_u_3.Text = "Let\'s make it rain blocks from the sky. They will start at a random Position plus or minus 30 studs, and 30 studs up. Press Play..."
