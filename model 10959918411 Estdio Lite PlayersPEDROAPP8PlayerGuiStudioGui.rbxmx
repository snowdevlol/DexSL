function easeIn(p1, p2)
	return p2(p1)
end
function easeOut(p3, p4)
	return 1 - p4(1 - p3)
end
function easeInOut(p5, p6)
	local v7 = p5 * 2
	if v7 < 1 then
		return easeIn(v7, p6) * 0.5
	else
		return 0.5 + easeOut(v7 - 1, p6) * 0.5
	end
end
function bounce(p8)
	if p8 < 0.36363636 then
		return 7.5625 * p8 * p8
	elseif p8 < 0.72727272 then
		local v9 = p8 - 0.54545454
		return 7.5625 * v9 * v9 + 0.75
	elseif p8 < 0.9090909 then
		local v10 = p8 - 0.81818181
		return 7.5625 * v10 * v10 + 0.9375
	else
		local v11 = p8 - 0.95454545
		return 7.5625 * v11 * v11 + 0.984375
	end
end
function cubic(p12)
	return p12 ^ 3
end
return {
	["GetEasing"] = function(p13, p14, p15)
		if p13 == "Bounce" then
			if p14 == "Out" then
				return 1 - easeOut(p15, bounce)
			elseif p14 == "In" then
				return 1 - bounce(p15)
			else
				return 1 - easeInOut(p15, bounce)
			end
		else
			if p13 == "Elastic" then
				if p14 == "Out" then
					local v16 = 1 - p15
					local v17 = 2 ^ (-10 * v16)
					local v18 = (v16 * 1 - 0.075) * 6.283185307179586 / 0.3
					return 1 + v17 * math.sin(v18)
				end
				if p14 == "In" then
					local v19 = 2 ^ (-10 * p15)
					local v20 = (p15 * 1 - 0.075) * 6.283185307179586 / 0.3
					return 1 - (1 + v19 * math.sin(v20))
				end
				if p14 == "InOut" then
					local v21 = p15 * 2
					if v21 < 1 then
						local v22 = v21 - 1
						local v23 = -0.5 * 2 ^ (10 * v22)
						local v24 = (v22 - 0.11249999999999999) * 6.283185307179586 / 0.44999999999999996
						return 1 - v23 * math.sin(v24)
					else
						local v25 = v21 - 1
						local v26 = 0.5 * 2 ^ (-10 * v25)
						local v27 = (v25 - 0.11249999999999999) * 6.283185307179586 / 0.44999999999999996
						return 1 - (1 + v26 * math.sin(v27))
					end
				end
			elseif p13 == "Cubic" or p13 == "CubicV2" then
				if p14 == "Out" then
					return 1 - easeOut(p15, cubic)
				end
				if p14 == "In" then
					return 1 - cubic(p15)
				end
				if p14 == "InOut" then
					return 1 - easeInOut(p15, cubic)
				end
			else
				if p13 == "Linear" then
					return 1 - p15
				end
				if p13 == "Constant" then
					if p13 == "Out" then
						return 1
					end
					if p13 == "In" then
						return 0
					end
					if p13 == "InOut" then
						return 0.5
					end
				end
			end
			return
