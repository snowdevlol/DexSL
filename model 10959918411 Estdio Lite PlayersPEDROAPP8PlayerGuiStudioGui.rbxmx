-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[AnimationLiteService]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties><Item class="TextBox" referent="2681"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[<font color="#00ff00">--AnimationLiteService - Adapted verious examples to create a Procedural KeyframeSequence player using C0 so it blends with regular animations.  ScottSpiritWalker, 08/21/2025.</font>

<b><font color='#9090ff'>local</font></b> TS = game:<font color="#00ffff">GetService(</font><font color="#ff2020">"TweenService"</font>)
<b><font color='#9090ff'>local</font></b> runservice = game:<font color="#00ffff">GetService(</font><font color="#ff2020">"RunService"</font>)

<b><font color='#9090ff'>local</font></b> tStyle, tDirection = {
[Enum.PoseEasingStyle.Linear]    = Enum.EasingStyle.Linear;
[Enum.PoseEasingStyle.Bounce]    = Enum.EasingStyle.Bounce;
[Enum.PoseEasingStyle.Cubic]    = Enum.EasingStyle.Cubic;
[Enum.PoseEasingStyle.CubicV2]    = Enum.EasingStyle.Cubic;
[Enum.PoseEasingStyle.Elastic]    = Enum.EasingStyle.Elastic;
[Enum.PoseEasingStyle.Constant]    = Enum.EasingStyle.Linear;
},{
[Enum.PoseEasingDirection.In]    = Enum.EasingDirection.In;
[Enum.PoseEasingDirection.Out]    = Enum.EasingDirection.Out;
[Enum.PoseEasingDirection.InOut]= Enum.EasingDirection.InOut;
}

<b><font color='#9090ff'>function</font></b> <font color="#00ffff">PlayKeyframeSequence(</font>Model, KeyframeSequence, SpeedMult, StartAtFrameNum, StopAtFrameNum)
    <b><font color='#9090ff'>if</font></b> not Model <b><font color='#9090ff'>or</font></b> not Model.Parent <b><font color='#9090ff'>or</font></b> not KeyframeSequence <b><font color='#9090ff'>or</font></b> not KeyframeSequence.Parent <b><font color='#9090ff'>then</font></b>   <font color="#00ff00">--Incase the stop button destroys the model.</font>
        <font color="#00ff00">--print("Play animation aborted. Model:",Model,"KeyframeSequence",KeyframeSequence)</font>
        <font color="#00ffff">pcall(</font><b><font color='#9090ff'>function</font></b>()
            Model:<font color="#00ffff">SetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>,nil)
        <b><font color='#9090ff'>end</font></b>)
        <b><font color='#9090ff'>return</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>if</font></b> Model:<font color="#00ffff">GetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>) <b><font color='#9090ff'>or</font></b> Model:<font color="#00ffff">GetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>) == false <b><font color='#9090ff'>then</font></b>        <font color="#00ff00">--Already Playing something.</font>
        Model:<font color="#00ffff">SetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>,false)
        <font color="#00ffff">print(</font><font color="#ff2020">"Can't play"</font>,Model,KeyframeSequence,<font color="#ff2020">" Previous animation is still playing."</font>)
        <font color="#00ffff">print(</font><font color="#ff2020">"Try stopping it <b><font color='#9090ff'>or</font></b> waiting <b><font color='#9090ff'>for</font></b> it to finish. See comments <b><font color='#9090ff'>in</font></b> the AnimationLitePlayScript."</font>)
        <b><font color='#9090ff'>return</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    Model:<font color="#00ffff">SetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>,true)
    <b><font color='#9090ff'>if</font></b> not SpeedMult <b><font color='#9090ff'>then</font></b>
        SpeedMult = 1
    <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>if</font></b> not StopAtFrameNum <b><font color='#9090ff'>then</font></b>
        StopAtFrameNum = 9999
    <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>if</font></b> (not StartAtFrameNum) <b><font color='#9090ff'>or</font></b> StartAtFrameNum > StopAtFrameNum <b><font color='#9090ff'>or</font></b> StartAtFrameNum &lt; 1 <b><font color='#9090ff'>then</font></b>
        StartAtFrameNum = 1
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>local</font></b> AllKeyframes = {}
    
    <b><font color='#9090ff'>for</font></b> i,Keyframe <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>KeyframeSequence:<font color="#00ffff">GetKeyframes(</font>)) do
        table.<font color="#00ffff">insert(</font>AllKeyframes, {
        Time = Keyframe.Time,
        Keyframe = Keyframe
        })
    <b><font color='#9090ff'>end</font></b>
    table.<font color="#00ffff">sort(</font>AllKeyframes, <b><font color='#9090ff'>function</font></b>(a, b)
        <b><font color='#9090ff'>return</font></b> a.Time &lt; b.Time
    <b><font color='#9090ff'>end</font></b>)
    
    <b><font color='#9090ff'>local</font></b> tweens = {}
    <b><font color='#9090ff'>local</font></b> motors = {}
    <b><font color='#9090ff'>local</font></b> motorValues = {}
    <b><font color='#9090ff'>local</font></b> KeyframePoses = {}
    
    <b><font color='#9090ff'>local</font></b> rigMismatch = false
    
    <b><font color='#9090ff'>local</font></b> <b><font color='#9090ff'>function</font></b> <font color="#00ffff">GetMotorFromPose(</font>Pose, Keyframe)
        <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>Model:<font color="#00ffff">GetDescendants(</font>)) do
            <b><font color='#9090ff'>if</font></b> v:<font color="#00ffff">IsA(</font><font color="#ff2020">"Motor6D"</font>) <b><font color='#9090ff'>then</font></b>
                <b><font color='#9090ff'>if</font></b> v.Part1 <b><font color='#9090ff'>and</font></b> v.Part1.Name == Pose.Name <b><font color='#9090ff'>then</font></b>
                    <b><font color='#9090ff'>local</font></b> initC0 = v:<font color="#00ffff">FindFirstChild(</font><font color="#ff2020">"InitC0"</font>)
                    <b><font color='#9090ff'>if</font></b> initC0 <b><font color='#9090ff'>then</font></b>
                        v.C0 = initC0.Value  <font color="#00ff00">--If we played it before, reset to initial values.</font>
                    <b><font color='#9090ff'>else</font></b>
                        initC0 = Instance.<font color="#00ffff">new(</font><font color="#ff2020">"CFrameValue"</font>)
                        initC0.Name = <font color="#ff2020">"InitC0"</font>
                        initC0.Value = v.C0 
                        initC0.Parent = v
                    <b><font color='#9090ff'>end</font></b>
                    <b><font color='#9090ff'>return</font></b> v
                <b><font color='#9090ff'>end</font></b>
            <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>end</font></b>
        rigMismatch = true
        <b><font color='#9090ff'>return</font></b> nil
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>local</font></b> excessTimeAfterLastPose = 0        <font color="#00ff00">-- Some anims have a special keyframe with no poses to hold the total animation length when there is unused time on the end of the animation.</font>
    <b><font color='#9090ff'>if</font></b> #AllKeyframes > 1 <b><font color='#9090ff'>and</font></b> #AllKeyframes[#AllKeyframes].Keyframe:<font color="#00ffff">GetDescendants(</font>) == 0 <b><font color='#9090ff'>then</font></b>
        excessTimeAfterLastPose = (AllKeyframes[#AllKeyframes].Time - AllKeyframes[#AllKeyframes - 1].Time) * SpeedMult
        table.<font color="#00ffff">remove(</font>AllKeyframes,#AllKeyframes)
    <b><font color='#9090ff'>end</font></b> 
    
    <b><font color='#9090ff'>for</font></b> i,Keyframe <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>AllKeyframes) do
        <b><font color='#9090ff'>for</font></b> x,Pose <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>Keyframe.Keyframe:<font color="#00ffff">GetDescendants(</font>)) do
            <b><font color='#9090ff'>if</font></b> Pose:<font color="#00ffff">IsA(</font><font color="#ff2020">"Pose"</font>) <b><font color='#9090ff'>and</font></b> Pose.Weight>0 <b><font color='#9090ff'>then</font></b>
                <b><font color='#9090ff'>local</font></b> Motor6D = motors[Pose.Name] <b><font color='#9090ff'>or</font></b> <font color="#00ffff">GetMotorFromPose(</font>Pose, Keyframe)
                <b><font color='#9090ff'>if</font></b> Motor6D <b><font color='#9090ff'>then</font></b>
                    <b><font color='#9090ff'>if</font></b> not KeyframePoses[i] <b><font color='#9090ff'>then</font></b>
                        KeyframePoses[i] = {
                        Time = Keyframe.Time * SpeedMult,
                        Poses = {}
                        }
                    <b><font color='#9090ff'>end</font></b>
                    <b><font color='#9090ff'>if</font></b> not motors[Pose.Name] <b><font color='#9090ff'>then</font></b>
                        motors[Pose.Name] = Motor6D
                    <b><font color='#9090ff'>end</font></b>
                    <b><font color='#9090ff'>if</font></b> not motorValues[Pose.Name] <b><font color='#9090ff'>then</font></b>
                        <b><font color='#9090ff'>local</font></b> mv = motors[Pose.Name]:<font color="#00ffff">FindFirstChild(</font><font color="#ff2020">"MotorValue"</font>)
                        <b><font color='#9090ff'>if</font></b> mv <b><font color='#9090ff'>and</font></b> mv.Name == <font color="#ff2020">"MotorValue"</font> <b><font color='#9090ff'>then</font></b>
                            mv.Value = Motor6D.InitC0.Value   <font color="#00ff00">--Fixed initial starting point. ScottSpiritWalker, 11/04/2025.</font>
                            motorValues[Pose.Name] = mv
                        <b><font color='#9090ff'>else</font></b>
                            <b><font color='#9090ff'>local</font></b> motorVal = Instance.<font color="#00ffff">new(</font><font color="#ff2020">"CFrameValue"</font>)
                            motorVal.Name = <font color="#ff2020">"MotorValue"</font>
                            motorVal.Parent = motors[Pose.Name]
                            motorVal.Value = Motor6D.InitC0.Value   <font color="#00ff00">--Fixed initial starting point. ScottSpiritWalker, 11/04/2025.</font>
                            motorValues[Pose.Name] = motorVal
                        <b><font color='#9090ff'>end</font></b>
                    <b><font color='#9090ff'>end</font></b>
                    KeyframePoses[i].Poses[Pose.Name] = {Motor6D = Motor6D, Pose = Pose}
                <b><font color='#9090ff'>end</font></b>
            <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>if</font></b> rigMismatch <b><font color='#9090ff'>then</font></b>
        <b><font color='#9090ff'>if</font></b> Model.Humanoid.RigType == Enum.HumanoidRigType.R6 <b><font color='#9090ff'>then</font></b>
            <font color="#00ffff">warn(</font><font color="#ff2020">"Motor mismatch:"</font>,KeyframeSequence.Name,<font color="#ff2020">"is an R15 animation, but the rig is R6."</font>)
        <b><font color='#9090ff'>elseif</font></b> Model.Humanoid.RigType == Enum.HumanoidRigType.R15 <b><font color='#9090ff'>then</font></b>
            <font color="#00ffff">warn(</font><font color="#ff2020">"Motor mismatch:"</font>,KeyframeSequence.Name,<font color="#ff2020">"is an R6 animation, but the rig is R15."</font>)
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>if</font></b> #KeyframePoses > 0 <b><font color='#9090ff'>then</font></b>
        <b><font color='#9090ff'>local</font></b> lastPose = {}
        <b><font color='#9090ff'>for</font></b> i = StartAtFrameNum, math.<font color="#00ffff">min(</font>#KeyframePoses - 1, StopAtFrameNum) do
            <b><font color='#9090ff'>local</font></b> Kf1, Kf2 
            <b><font color='#9090ff'>if</font></b> #KeyframePoses == 1 <b><font color='#9090ff'>then</font></b>    
                Kf1, Kf2 = KeyframePoses[i], KeyframePoses[i]
                Kf1.Time, Kf2.Time = 0.001,0.002
            <b><font color='#9090ff'>else</font></b>
                Kf1, Kf2 = KeyframePoses[i], KeyframePoses[i+1]
            <b><font color='#9090ff'>end</font></b>
            
            <b><font color='#9090ff'>local</font></b> t = Kf2.Time-Kf1.Time
            tweens[i] = {
            Time = t,
            Tweens = {}
            }
            <b><font color='#9090ff'>for</font></b> name,data <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>Kf1.Poses) do
                lastPose[name] = data
                lastPose[name].StartIndex = i    <font color="#00ff00">--ScottSpiritWalker - position start of tween at the true start</font>
                lastPose[name].Time = Kf1.Time
            <b><font color='#9090ff'>end</font></b>
            
            <b><font color='#9090ff'>for</font></b> name,data <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>Kf2.Poses) do
                <b><font color='#9090ff'>if</font></b> not lastPose[name] <b><font color='#9090ff'>then</font></b>            <font color="#00ff00">--ScottSpiritWalker - Create starting frame if none exists.</font>
                    lastPose[name] = data
                    lastPose[name].Pose.EasingStyle = Enum.PoseEasingStyle.Linear
                    lastPose[name].Pose.EasingDirection = Enum.PoseEasingDirection.In
                    lastPose[name].Pose.CFrame = CFrame.<font color="#00ffff">new(</font>)
                    lastPose[name].Time = 0
                    lastPose[name].StartIndex = StartAtFrameNum
                    <font color="#00ffff">print(</font><font color="#ff2020">"SL_Make StartFrame"</font>,name,data)
                <b><font color='#9090ff'>end</font></b>
                <font color="#00ff00">--print(lastPose,lastPose[name])</font>
                <b><font color='#9090ff'>local</font></b> tweeninfo = TweenInfo.<font color="#00ffff">new(</font>
                math.<font color="#00ffff">abs(</font>lastPose[name].Time-Kf2.Time),
                tStyle[lastPose[name].Pose.EasingStyle],
                tDirection[lastPose[name].Pose.EasingDirection]
                )
                <font color="#00ff00">--ScottSpiritWalker - Index the tween from the start of the pose. And change values for C0, not motors, since Transform dosn't seem to work without disabling the Animator.</font>
                <font color="#00ff00">--tweens[lastPose[name].StartIndex].Tweens[name] = TS:Create(motorValues[name],tweeninfo,{Value=CFrame.new(motors[data.Pose.Name].C0.Position) * data.Pose.CFrame})</font>
                tweens[lastPose[name].StartIndex].Tweens[name] = TS:<font color="#00ffff">Create(</font>motorValues[name],tweeninfo,{Value=motors[data.Pose.Name].C0 * data.Pose.CFrame})
                
            <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>local</font></b> breakPlay = false
    
    <b><font color='#9090ff'>local</font></b> <b><font color='#9090ff'>function</font></b> <font color="#00ffff">play(</font>)
        <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>motors) do
            <font color="#00ff00">--print("SL_motor",v.Name)</font>
            <b><font color='#9090ff'>local</font></b> initC0 = v:<font color="#00ffff">FindFirstChild(</font><font color="#ff2020">"InitC0"</font>)
            <b><font color='#9090ff'>if</font></b> initC0 <b><font color='#9090ff'>and</font></b> v.C0 ~= initC0.Value <b><font color='#9090ff'>then</font></b>
                v.C0 = initC0.Value
                motorValues[i].Value = initC0.Value
            <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>tweens) do
            <b><font color='#9090ff'>if</font></b> not Model <b><font color='#9090ff'>or</font></b> not Model.Parent <b><font color='#9090ff'>or</font></b> not KeyframeSequence <b><font color='#9090ff'>or</font></b> not KeyframeSequence.Parent <b><font color='#9090ff'>then</font></b>   <font color="#00ff00">--Incase the stop button destroys the model.</font>
                <font color="#00ff00">--StopAtFrameNum = 0 --break out of play loop tool</font>
                breakPlay = true
                <b><font color='#9090ff'>break</font></b>
            <b><font color='#9090ff'>end</font></b>
            <b><font color='#9090ff'>if</font></b> (not Model:<font color="#00ffff">GetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>)) <b><font color='#9090ff'>then</font></b>
                <b><font color='#9090ff'>break</font></b>
            <b><font color='#9090ff'>end</font></b>
            <font color="#00ff00">--if i >= StartAtFrameNum and i &lt;= StopAtFrameNum then </font>
            <b><font color='#9090ff'>for</font></b> _,tween <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>v.Tweens) do
                tween:<font color="#00ffff">Play(</font>)
            <b><font color='#9090ff'>end</font></b>
            task.<font color="#00ffff">wait(</font>v.Time)
        <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>if</font></b> Model:<font color="#00ffff">GetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>) <b><font color='#9090ff'>then</font></b>
            task.<font color="#00ffff">wait(</font>excessTimeAfterLastPose)
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>local</font></b> myBreak = false
    <b><font color='#9090ff'>local</font></b> myTicks = <font color="#00ffff">tick(</font>)
    <b><font color='#9090ff'>local</font></b> runConnection
    
    runConnection = runservice.Stepped:<font color="#00ffff">Connect(</font><b><font color='#9090ff'>function</font></b>()
        <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>motors) do
            <b><font color='#9090ff'>if</font></b> myBreak <b><font color='#9090ff'>then</font></b>
                runConnection:<font color="#00ffff">Disconnect(</font>)
                <b><font color='#9090ff'>break</font></b>
            <b><font color='#9090ff'>end</font></b>
            <b><font color='#9090ff'>if</font></b> v.C0 ~= motorValues[i].Value <b><font color='#9090ff'>then</font></b>
                v.C0 = motorValues[i].Value
            <b><font color='#9090ff'>end</font></b>
            <font color="#00ff00">--v.Transform = motorValues[i].Value</font>
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>)
    <font color="#00ff00">--print("SL_Play",Model.Name,KeyframeSequence.Name)</font>
    <b><font color='#9090ff'>while</font></b> Model:<font color="#00ffff">GetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>) do
        <font color="#00ffff">play(</font>)
        <b><font color='#9090ff'>if</font></b> KeyframeSequence.Loop == false <b><font color='#9090ff'>or</font></b> breakPlay <b><font color='#9090ff'>then</font></b>        
            <b><font color='#9090ff'>break</font></b>
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <font color="#00ff00">--print("SL_Disconnect",Model.Name,KeyframeSequence.Name)</font>
    myBreak = true
    task.<font color="#00ffff">wait(</font>)
    
    <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>tweens) do
        <b><font color='#9090ff'>for</font></b> _,tween <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>v.Tweens) do
            tween:<font color="#00ffff">Cancel(</font>)
            tween:<font color="#00ffff">Destroy(</font>)
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <b><font color='#9090ff'>if</font></b> StopAtFrameNum == 9999 <b><font color='#9090ff'>then</font></b>  <font color="#00ff00">--Play the whole animation, then reset the C0 values.  If you set a stop frame, then leave the C0 values as is (Statue mode).</font>
        <b><font color='#9090ff'>for</font></b> i,v <b><font color='#9090ff'>in</font></b> <font color="#00ffff">pairs(</font>motors) do
            <font color="#00ff00">--print("SL_motor",v.Name)</font>
            <b><font color='#9090ff'>local</font></b> initC0 = v:<font color="#00ffff">FindFirstChild(</font><font color="#ff2020">"InitC0"</font>)
            <b><font color='#9090ff'>if</font></b> initC0 <b><font color='#9090ff'>and</font></b> v.C0 ~= initC0.Value <b><font color='#9090ff'>then</font></b>
                v.C0 = initC0.Value
                motorValues[i].Value = initC0.Value
            <b><font color='#9090ff'>end</font></b>
        <b><font color='#9090ff'>end</font></b>
    <b><font color='#9090ff'>end</font></b>
    
    <font color="#00ffff">pcall(</font><b><font color='#9090ff'>function</font></b>()  <font color="#00ff00">--Incase the stop button destroys the model.</font>
        Model:<font color="#00ffff">SetAttribute(</font><font color="#ff2020">"AnimationLitePlaying"</font>,nil)
    <b><font color='#9090ff'>end</font></b>)
<b><font color='#9090ff'>end</font></b>

<b><font color='#9090ff'>local</font></b> AnimationLitePlayEvent = script:<font color="#00ffff">WaitForChild(</font><font color="#ff2020">"AnimationLitePlayEvent"</font>)
AnimationLitePlayEvent.Event:<font color="#00ffff">Connect(</font>PlayKeyframeSequence)        <font color="#00ff00">--function(Model, KeyframeSequence, SpeedMult, StartAtFrameNum, StopAtFrameNum)</font>

]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><token name="Sink">1</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties><Item class="ObjectValue" referent="2682"><Properties><Ref name="Value">2681</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties></Item><Item class="LocalScript" referent="2683"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

if not _G.DynamicThumb then
	local v1 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder")
	local v_u_2 = require(v1:WaitForChild("ColorizeSourceModule"))
	script.Parent.Text = v_u_2:ColorizeSource(script.Parent.ContentText, false, true)
	script.Parent.Focused:Connect(function()
		script.Parent.Text = script.Parent.ContentText
		script.Parent.CursorPosition = 0
	end)
	script.Parent.FocusLost:Connect(function()
		-- upvalues: (copy) v_u_2
		task.wait()
		script.Parent:WaitForChild("SaveChangesTo").Value.Text = script.Parent.ContentText
		script.Parent.Text = v_u_2:ColorizeSource(script.Parent.ContentText, false, true)
	end)
end]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_ColorizeAndEditLocal]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties></Item></Item><Item class="BindableEvent" referent="2684"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[AnimationLitePlayEvent]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties></Item></Item><Item class="Script" referent="2685"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[AnimationLitePlayScript]]></string><BinaryString name="SerializedOverrides"></BinaryString></Properties><Item class="TextBox" referent="2686"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[<font color="#00ff00">----------------------------------------------------------------------------------------</font>
<font color="#00ff00">--  AnimationLitePlayScript  --  This Script is automatically inserted into a Rig by  --</font>
<font color="#00ff00">--  Studio Lite's "Animation Lite" if checkmarked while saving the KeyframeSequence.  --</font>
<font color="#00ff00">--  You are free to change this script, place it inside Players, trigger it by GUI    --</font>
<font color="#00ff00">--  or play it when a part is touched or a tool is equipped. Be sure to change the    --</font>
<font color="#00ff00">--  script name so the checkmark in Animation Lite won't overwrite your work.         --</font>
<font color="#00ff00">--                                                 --ScottSpiritWalker, 10/30/2025.   --</font>
<font color="#00ff00">----------------------------------------------------------------------------------------</font>

<b><font color='#9090ff'>local</font></b> AnimationLitePlayEvent = game.ServerScriptService.AnimationLiteService.AnimationLitePlayEvent
task.<font color="#00ffff">wait(</font>1)  <font color="#00ff00">--wait for server to start so you can see the animation.</font>
AnimationLitePlayEvent:<font color="#00ffff">Fire(</font>script.Parent, script.KeyframeSequence.Value,1)   <font color="#00ff00">--Start playing animation and continue this script.  </font>
<font color="#00ff00">--Parameters: rig, KeyframeSequence, speed=1, startKeyframe=1 and endKeyframe=9999</font>
<font color="#00ff00">--The last two parameters can be used to pose a statue frozen at a particular frame number.</font>


<font color="#00ff00">--------Request Stop playing an animation early, or stop a looped animation.</font>
<font color="#00ff00">--while script.Parent:GetAttribute("AnimationLitePlaying") ~= nil do --stop currently playing animation if any.</font>
<font color="#00ff00">--    script.Parent:SetAttribute("AnimationLitePlaying",false)</font>
<font color="#00ff00">--    task.wait()</font>
<font color="#00ff00">--end</font>


<font color="#00ff00">--repeat     --Wait for a non looped animation to end.</font>
<font color="#00ff00">--    task.wait(.1)    </font>
<font color="#00ff00">--until script.Parent:GetAttribute("AnimationLitePlaying") == nil</font>

<font color="#00ff00">--The above examples are for NPC rigs. </font>


<font color="#00ff00">----------To fire this animation from a GUI button:</font>
<font color="#00ff00">----------You will need a LocalScript in each Gui button (if more than one), something like these five lines:</font>
<font color="#00ff00">--local AnimationLiteGuiActivated = game.ReplicatedStorage:WaitForChild("AnimationLiteGuiActivated",9999)</font>
<font color="#00ff00">--local guiButton = script.Parent</font>
<font color="#00ff00">--guiButton.Activated:Connect(function()</font>
<font color="#00ff00">--    AnimationLiteGuiActivated:FireServer("happy dance")  --Incase you have several animation buttons, you can pass the name to identify which to play.</font>
<font color="#00ff00">--end)</font>

<font color="#00ff00">----------Next you need a Script in ServerScriptServices something like this:</font>
<font color="#00ff00">--local AnimationLitePlayEvent = game.ServerScriptService.AnimationLiteService.AnimationLitePlayEvent</font>
<font color="#00ff00">--local AnimationLiteGuiActivated = script:FindFirstChild("AnimationLiteGuiActivated")</font>
<font color="#00ff00">--if not AnimationLiteGuiActivated then</font>
<font color="#00ff00">--    AnimationLiteGuiActivated = Instance.new("RemoteEvent")</font>
<font color="#00ff00">--    AnimationLiteGuiActivated.Name = "AnimationLiteGuiActivated"                 </font>
<font color="#00ff00">--    AnimationLiteGuiActivated.Parent = game.ReplicatedStorage</font>
<font color="#00ff00">--end</font>
<font color="#00ff00">--local paused = false   --Debounce to prevent other animation play request until this one is started.</font>
<font color="#00ff00">--AnimationLiteGuiActivated.OnServerEvent:Connect(function(player,whichAnim)    --Triggered when a LocalScript calls FireServer. </font>
<font color="#00ff00">--    if not paused and player and player.Character then</font>
<font color="#00ff00">--        paused = true</font>
<font color="#00ff00">--        while player.Character:GetAttribute("AnimationLitePlaying") ~= nil do --stop currently playing animation if any.</font>
<font color="#00ff00">--            player.Character:SetAttribute("AnimationLitePlaying",false)</font>
<font color="#00ff00">--            task.wait()</font>
<font color="#00ff00">--        end</font>
<font color="#00ff00">--        AnimationLitePlayEvent:Fire(player.Character, game.ServerStorage.RBX_ANIMSAVES[whichAnim],1)</font>
<font color="#00ff00">--        paused = false</font>
<font color="#00ff00">--    end</font>
<font color="#00ff00">--end)</font>



<font color="#00ff00">----------If you want to replace the player's default run, idle, swim, etc, with your own custom animations:</font>
<font color="#00ff00">----------You will need a LocalScript in StarterCharacterScripts something like this to capture changes to the player's state:</font>
<font color="#00ff00">--local AnimationLiteRemoteTrigger = game.ReplicatedStorage:WaitForChild("AnimationLiteRemoteTrigger",9999)</font>
<font color="#00ff00">--local char = script.Parent</font>
<font color="#00ff00">--char:WaitForChild("Animate").Enabled = false   --Stop Roblox character animations.</font>
<font color="#00ff00">--local humanoid = char:WaitForChild("Humanoid")</font>
<font color="#00ff00">--for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do</font>
<font color="#00ff00">--    track:Stop()</font>
<font color="#00ff00">--end</font>
<font color="#00ff00">--while task.wait(.1) do </font>
<font color="#00ff00">--    if humanoid.MoveDirection.magnitude &lt; .1 then</font>
<font color="#00ff00">--        task.wait()  --Give non looped anims priority.</font>
<font color="#00ff00">--        if currentAnim ~= "idle" and currentAnim ~= "pause" then</font>
<font color="#00ff00">--            currentAnim = "idle"</font>
<font color="#00ff00">--            AnimationLiteRemoteTrigger:FireServer("myIdle",false) --false means this is a looped anim that needs to be stopped at some point.</font>
<font color="#00ff00">--        end</font>
<font color="#00ff00">--    else</font>
