						v_u_18.Text = "--Rain parts.\nlocal Debris = game:GetService(\"Debris\")  --Roblox utility to destroy stuff.\nwhile true do\n  wait(.2)     --.2 is one fifth of a second.  So five bricks per second.\n  local newBrick = Instance.new(\"Part\")\n  newBrick.Position = Vector3.new(math.random(-30,30), 30, math.random(-30,30))\n  newBrick.Color = Color3.fromRGB(math.random(255), math.random(255), math.random(255))\n  newBrick.Parent = game.Workspace\n  Debris:AddItem(newBrick, 10)  --Delete each brick 10 seconds after it\'s created.\nend\n"
