				v_u_18.Text = "local myGold = 10\nlocal myMessage = \"My gold:\"\nmyMessage = myMessage .. tostring(myGold)\nlocal spLoc = game.Workspace.SpawnLocation\nspLoc.Transparency = 1     --1 means transparent.\nspLoc.CanCollide = false   --false means no checkmark."
