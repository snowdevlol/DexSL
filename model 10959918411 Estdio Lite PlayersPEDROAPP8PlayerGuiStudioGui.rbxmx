				v_u_3.Text = "It moved 90 pixels from the left (X), and down 20 from the top (Y). To center it set the position to {.5,-100},{.5,-25}. That\'s half the screen width minus half the TextLabel width. Then down half the screen height and minus half the TextLabel height."
				SetNumLines("LinesFrame", 5, 0, 0.01, 0.6, 0.7, 0.3)
