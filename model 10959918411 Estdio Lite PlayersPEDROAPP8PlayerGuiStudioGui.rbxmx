				v_u_5.Text = "Next"
				SetNumLines("LinesFrame", 4, 1, 0.01, 0.7, 0.77, 0.23)
				ButtonClickWait()
				if v_u_23 == 99 then
					return
				end
				v_u_3.Text = "The second line is another new variable: potOfGold set to 25. The third line sets myGold to the sum of myGold + potOfGold. The fourth line prints some words along with the current myGold value.  What will the answer be?  Let\'s Play it and see."
				SetNumLines("LinesFrame", 4, 0, 0.01, 0.7, 0.72, 0.28)
