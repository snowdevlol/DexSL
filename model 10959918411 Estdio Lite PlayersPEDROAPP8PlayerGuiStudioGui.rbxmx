				v_u_18:WaitForChild("SaveChangesTo").Value.Text = v_u_18.ContentText
				v_u_3.Text = "In scripting capitalization and punctuation are important. For example, \'local\' must be all lowercase. To demonstrate I changed the second \'Local\' to be capital \'L\'.  It won\'t be happy with that.  Play it and see what happens."
				SetNumLines("LinesFrame", 4, 0, 0.01, 0.7, 0.8, 0.2)
