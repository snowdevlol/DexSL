						v_u_18.Text = "local spLoc = game.Workspace.SpawnLocation\nwhile true do\n  wait(.5)                                --Pause half a second.\n  spLoc.Position = Vector3.new(0,.5,12)   --Move it forward 12 studs.\n  spLoc.Color = Color3.fromRGB(math.random(255), math.random(255), math.random(255))   --random color.\n  wait(.5)\n  spLoc.Position = Vector3.new(0,.5,0)    --Move it back.\n  spLoc.Color = Color3.fromRGB(math.random(255), math.random(255), math.random(255))\nend\n"
