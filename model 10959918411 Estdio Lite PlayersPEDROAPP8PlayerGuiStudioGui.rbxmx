				v_u_18 = v_u_49.ViewScriptFrame:WaitForChild("ScrollingFrame"):WaitForChild("SL_CodeTextBox")
				v_u_18.Text = "local myGold = 10\nlocal potOfGold = 25\nmyGold = myGold + potOfGold\nprint(\"myGold is:\", myGold)"
				task.wait(0.1)
				if v_u_49.TutorialFrame.Visible == false then
					return
				end
				v_u_18:WaitForChild("SaveChangesTo").Value.Text = v_u_18.ContentText
