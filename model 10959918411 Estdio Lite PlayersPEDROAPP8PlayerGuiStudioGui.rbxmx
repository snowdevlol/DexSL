						v_u_18.Text = "--TP players who wander too far from the SpawnLocation.\nlocal spLoc = game.Workspace:WaitForChild(\"SpawnLocation\")\nlocal hrp      --variable to hold the HumanoidRootPart of the current player.\nwhile true do\n  for i,player in pairs(game.Players:GetChildren()) do   --for each player...\n    if player.Character then    --Did player spawn enough to have a character model yet?\n      hrp = player.Character:FindFirstChild(\"HumanoidRootPart\")   --Did it spawn enough to have a HumanoidRootPart?\n      if hrp and (hrp.Position - spLoc.Position).magnitude > 20 then   --If so, and if the hrp is more than 20 studs from the Spawn, then...\n        hrp.Position = spLoc.Position + Vector3.new(0,10,0)   --Teleport it a little above the SpawnLocation.\n      end\n    end\n  end\n  wait(.5)   --All player have been processed at this point, so wait a sec and check again.\nend\n"
