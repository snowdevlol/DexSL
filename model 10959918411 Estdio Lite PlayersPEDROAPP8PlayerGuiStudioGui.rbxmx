				end
				v_u_3.Text = "Variables are an important part of scripting. A variable name can represent a number, a text string, or an object in Explorer. Let\'s demonstrate a number variable. I\'ll do the typing to save time."
				v_u_5.Text = "Show me"
				SetNumLines("LinesFrame", 4, 1, 0.01, 0.7, 0.7, 0.3)
